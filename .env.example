# ============================================================
# AI Speaker Provider API Keys
# ============================================================
# 사용할 클라우드 Provider에 해당하는 API 키만 설정하면 됩니다.
# API 키가 없으면 자동으로 로컬 Provider(Ollama/Piper/Whisper)로 폴백합니다.

# [필수] Anthropic Claude API (기본 LLM Provider)
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# [선택] OpenAI API (폴백 LLM/TTS/STT)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=your_openai_api_key_here

# [선택] Ollama 로컬 서버 (로컬 LLM 폴백)
# Ollama가 기본 포트가 아닌 곳에서 실행 중일 때만 설정
# OLLAMA_HOST=http://localhost:11434
